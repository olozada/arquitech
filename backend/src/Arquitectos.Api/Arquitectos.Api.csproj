<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>8f4c2a91-6d3e-4b70-9c15-a1e7d4b82f06</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="AspNetCore.HealthChecks.SqlServer" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Enrichers.CorrelationId" />
    <PackageReference Include="Serilog.Formatting.Compact" />
    <PackageReference Include="Serilog.Sinks.ApplicationInsights" />
    <PackageReference Include="Serilog.Sinks.Seq" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Arquitectos.Application\Arquitectos.Application.csproj" />
    <ProjectReference Include="..\Arquitectos.Infrastructure\Arquitectos.Infrastructure.csproj" />
  </ItemGroup>

  <Target Name="GenerarOpenApi" AfterTargets="Build" Condition="'$(GenerateOpenApi)' == 'true'">
    <PropertyGroup>
      <OpenApiSalida>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\frontend\swagger\v1\swagger.json'))</OpenApiSalida>
    </PropertyGroup>
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(OpenApiSalida)'))" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="dotnet tool run swagger -- tofile --output &quot;$(OpenApiSalida)&quot; &quot;$(TargetPath)&quot; v1" />
  </Target>

  <ItemGroup>
    <Content Update="appsettings.Production.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" Condition="Exists('appsettings.Production.json')" />
    <Content Update="appsettings.Production.example.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
