@Arquitectos.Api_HostAddress = http://localhost:5190
@password = {{$dotenv ADMIN_PASSWORD}}

GET {{Arquitectos.Api_HostAddress}}/api/health
Accept: application/json

###

POST {{Arquitectos.Api_HostAddress}}/api/auth/login
Content-Type: application/json
X-Requested-With: arquitectos

{
  "usuario": "admin",
  "password": "{{password}}"
}

###

# La sesión queda en la cookie arquitectos.acceso. Esta línea sigue valiendo si se pega un Bearer a mano.
GET {{Arquitectos.Api_HostAddress}}/api/menu
Authorization: Bearer {{token}}
Accept: application/json

###
