<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[Arquitectos.Application]*,[Arquitectos.Infrastructure]*</Include>
          <!-- Las migraciones las genera EF. No miden el código de la aplicación. -->
          <Exclude>[Arquitectos.Infrastructure]Arquitectos.Infrastructure.Persistence.Migrations.*</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
