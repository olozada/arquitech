# Copia este archivo a .env en la raíz del repositorio. No pongas la clave aquí.
# La base del proyecto es ARQUITECTOS.
# --reset, --seed-demo y --seed-plantilla exigen un nombre que termine en _DEV, _E2E, _TEST o _QA.
ARQUITECTOS_DB_HOST=
ARQUITECTOS_DB_NAME=ARQUITECTOS
ARQUITECTOS_DB_USER=
ARQUITECTOS_DB_PASSWORD=
